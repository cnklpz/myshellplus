{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MyShell+",
  "version": "0.2.2",
  "identifier": "com.myshellplus.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MyShell+",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0a0c0f"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyMjJGMjU3RDE4RkFDRkYKUldUL3JJL1JWL0lpUWpSMXZVUkZrZTA1ellpU1VwRGpwMGRadFRTaWZSRlcrd00zRHRydWVDVkgK",
      "endpoints": [
        "https://github.com/cnklpz/myshellplus/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}